# Copy to .env and fill in your Alpaca paper-trading keys.
# Never commit .env.
ALPACA_API_KEY=your-api-key-here
ALPACA_SECRET_KEY=your-secret-key-here

# Paper trading endpoint (default). The bot refuses to run against any
# other URL unless ALLOW_LIVE_TRADING=true is also set.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional
# ALPACA_DATA_FEED=iex        # iex (free plan) or sip (paid)
# ALLOW_LIVE_TRADING=false
# LOG_LEVEL=INFO
